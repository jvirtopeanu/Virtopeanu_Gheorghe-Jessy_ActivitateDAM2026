<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jessy_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/jessy_editText_oras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introdu_oras"
        android:inputType="textCapWords" />

    <Button
        android:id="@+id/jessy_button_cauta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cauta_oras" />

    <Spinner
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/prognoza_spinner"
        android:entries="@array/zile"/>

    <TextView
        android:id="@+id/jessy_textView_rezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/jessy_textView_temperaturi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="18sp" />

</LinearLayout>