<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/culege_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:text="1. Adaugă Vagon (Clasic)"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/culege_ai_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#3B82F6"
        android:text="2. Adaugă Vagon (Design AI ✨)"
        app:layout_constraintEnd_toEndOf="@id/culege_btn"
        app:layout_constraintStart_toStartOf="@id/culege_btn"
        app:layout_constraintTop_toBottomOf="@id/culege_btn" />

    <Button
        android:id="@+id/vezi_lista_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="3. Vezi lista vagoane"
        app:layout_constraintStart_toStartOf="@id/culege_ai_btn"
        app:layout_constraintEnd_toEndOf="@id/culege_ai_btn"
        app:layout_constraintTop_toBottomOf="@id/culege_ai_btn" />


</androidx.constraintlayout.widget.ConstraintLayout>