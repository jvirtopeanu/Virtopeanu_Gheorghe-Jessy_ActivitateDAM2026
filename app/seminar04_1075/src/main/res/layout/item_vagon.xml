<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:background="#E3F2FD">

    <TextView
        android:id="@+id/tipVagon_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tip vagon"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1565C0" />

    <TextView
        android:id="@+id/greutate_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/greutate"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/confort_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/confort"
        android:textSize="16sp" />

    <CheckBox
        android:id="@+id/functional_cb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/func_ional"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/dimensiune_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dimensiune"
        android:textSize="16sp" />

</LinearLayout>
