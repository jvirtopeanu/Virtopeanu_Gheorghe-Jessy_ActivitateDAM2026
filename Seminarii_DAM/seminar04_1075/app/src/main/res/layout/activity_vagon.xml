<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddVagonActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/titlu_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:text="@string/Adaugare_obiect_vagon"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/tipVagon_et"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/tip_vagon"
            android:inputType="textPersonName"
            app:layout_constraintEnd_toEndOf="@id/titlu_tv"
            app:layout_constraintStart_toStartOf="@id/titlu_tv"
            app:layout_constraintTop_toBottomOf="@id/titlu_tv" />

        <EditText
            android:id="@+id/greutate_et"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Greutate în tone"
            android:inputType="numberDecimal"
            app:layout_constraintEnd_toEndOf="@id/tipVagon_et"
            app:layout_constraintStart_toStartOf="@id/tipVagon_et"
            app:layout_constraintTop_toBottomOf="@id/tipVagon_et" />

        <Spinner
            android:id="@+id/garnitura_sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@id/greutate_et"
            app:layout_constraintStart_toStartOf="@id/greutate_et"
            app:layout_constraintTop_toBottomOf="@id/greutate_et" />

        <RatingBar
            android:id="@+id/confort_rb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:layout_editor_absoluteX="-16dp"
            tools:layout_editor_absoluteY="213dp"
            android:numStars="5"
            android:stepSize="0.5"
            app:layout_constraintStart_toStartOf="@id/garnitura_sp"
            app:layout_constraintTop_toBottomOf="@id/garnitura_sp"/>

        <CheckBox
            android:id="@+id/esteFunctional_cb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Vagonul este funcțional"
            app:layout_constraintStart_toStartOf="@id/confort_rb"
            app:layout_constraintTop_toBottomOf="@id/confort_rb" />

        <Switch
            android:id="@+id/areClimatizare_sw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sistem de climatizare / AC"
            app:layout_constraintEnd_toEndOf="@id/garnitura_sp"
            app:layout_constraintStart_toStartOf="@id/esteFunctional_cb"
            app:layout_constraintTop_toBottomOf="@id/esteFunctional_cb" />

        <RadioGroup
            android:id="@+id/dimensiune_rg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/areClimatizare_sw"
            app:layout_constraintStart_toStartOf="@id/areClimatizare_sw"
            app:layout_constraintTop_toBottomOf="@id/areClimatizare_sw">

            <RadioButton
                android:id="@+id/dimensiune20_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="20.0 m" />

            <RadioButton
                android:id="@+id/dimensiune26_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="26.4 m" />
        </RadioGroup>

        <Button
            android:id="@+id/salveaza_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Salvează Date"
            app:layout_constraintEnd_toEndOf="@id/dimensiune_rg"
            app:layout_constraintStart_toStartOf="@id/dimensiune_rg"
            app:layout_constraintTop_toBottomOf="@id/dimensiune_rg" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>